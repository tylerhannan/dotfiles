# Some days are better than others
alias HenryV='git commit -am "Once more unto the breach, dear friends," && git push -f origin master && shutdown -h now'
alias kthxbai='exit'

# Show/Hide Desktop icons during presentations or when overwhelmed
alias HideDesktop="defaults write com.apple.finder CreateDesktop -bool false && killall Finder"
alias ShowDesktop="defaults write com.apple.finder CreateDesktop -bool true && killall Finder"

# Demo Ghostty: bottom padding keeps the prompt above seated sightlines;
# opaque/no-blur for projectors. open -na = separate process. Overrides only.
# Flags are process-wide — Cmd+N in this instance stays demo-styled. Close the
# window (quit-after-last-window-closed) so Dock/Alfred reopen a normal Ghostty.
# Padding is points (not rows) — retune per display (400 ≈ mid-screen here).
alias demo='open -na Ghostty.app --args \
  --quit-after-last-window-closed=true \
  --window-padding-y=10,400 \
  --window-padding-color=background \
  --background-opacity=1 \
  --background-blur-radius=0 \
  --font-size=20'

# Turn on/off notification center
alias SoAnnoying="launchctl unload -w /System/Library/LaunchAgents/com.apple.notificationcenterui.plist"
alias BugMeAgain="launchctl load -w /System/Library/LaunchAgents/com.apple.notificationcenterui.plist"

# Mute/unmute system UI sounds (screenshot, Trash, boot chime, etc.)
alias QuietMac='defaults write NSGlobalDomain com.apple.sound.uiaudio.enabled -bool false && defaults write com.apple.screencapture disable-sound -bool true && sudo nvram SystemAudioVolume=" " 2>/dev/null; killall SystemUIServer 2>/dev/null || true'
alias LoudMac='defaults write NSGlobalDomain com.apple.sound.uiaudio.enabled -bool true && defaults write com.apple.screencapture disable-sound -bool false && sudo nvram -d SystemAudioVolume 2>/dev/null; killall SystemUIServer 2>/dev/null || true'

# Aliases for launching applications
alias vlc='open -a VLC'
alias mdown='open -a Byword'

# Aliases for things that require them
alias seedbox='ssh '
alias tunnel="screen ssh -D 55555 "

# Aliases for standard commands
alias l='ls -alh'
alias ls="ls -G"
alias lss="ls -l"
alias grep="grep --color=auto"
alias lsl="l -t | less"
alias c="clear"

# Typing is hard
alias cd..="cd .."
alias ..="cd .."
alias .2="cd ../.."
alias ...="cd ../.."
alias .3="cd ../../.."
alias ....="cd ../../.."
alias .4="cd ../../../.."
alias .....="cd ../../../.."

# I read numbers like a human
alias du='du -h'
alias df='df -h'

# Random Password Generation
alias randpass="openssl rand -base64 12"

# Git shortcuts
alias gs="git status" # Always used, shutup OCD. shutup OCD. shutup OCD.

# todo.txt (brew install todo-txt; ~/.todo.cfg from the formula)
alias t='todo.sh'

# Show/hide hidden files in Finder
alias show="defaults write com.apple.finder AppleShowAllFiles -bool true && killall Finder"
alias hide="defaults write com.apple.finder AppleShowAllFiles -bool false && killall Finder"

